{
  "name": "ochipazzle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "capacitor:sync:after": "node scripts/normalize-ios-package-paths.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:mobile": "node scripts/check-mobile.mjs",
    "test:regressions": "node scripts/check-regressions.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npm run cap:sync && npx cap open android",
    "cap:run:android": "npm run cap:sync && npx cap run android",
    "cap:add:ios": "npm run build && npx cap add ios",
    "cap:open:ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@supabase/supabase-js": "^2.112.2",
    "gameanalytics": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
